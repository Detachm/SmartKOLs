APP_DOMAIN=app.example.com
BACKEND_DOMAIN=api.example.com

SMARTKOLS_BACKEND_BASE_URL=https://api.example.com
SMARTKOLS_BACKEND_SHARED_SECRET=change-this-to-a-long-random-secret
SMARTKOLS_LOCAL_AUTH_ENABLED=true

# 留空则前端走当前仓库内置 /auth/x 路由。
NEXT_PUBLIC_SMARTKOLS_X_AUTH_BASE_URL=

BACKEND_PROXY_SHARED_SECRET=change-this-to-the-same-long-random-secret
LOCAL_AUTH_ENABLED=true

X_OAUTH2_CLIENT_ID=fill-me
X_OAUTH2_CLIENT_SECRET=fill-me
X_API_BASE_URL=https://api.twitter.com
X_API_REQUEST_TIMEOUT_MS=15000

SOURCE_FETCH_REQUEST_TIMEOUT_MS=15000
SOURCE_FETCH_USER_AGENT=SmartKOLsBackend/1.0 (+https://app.example.com)
SOURCE_FETCH_MAX_ITEMS=100

WORKER_POLL_INTERVAL_MS=3000
WORKER_MAX_JOBS_PER_TICK=20

# 开全量内容生成链必须启用 LLM 并填对应 provider 的 key。
LLM_ENABLED=true
LLM_PROVIDER=openai

OPENAI_API_KEY=fill-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
OPENAI_REVIEW_MODEL=gpt-5.4-mini
OPENAI_REQUEST_TIMEOUT_MS=120000
OPENAI_REASONING_EFFORT=high
OPENAI_STORE=false

# 如改用智谱，打开下面这组并把上面的 LLM_PROVIDER 改成 zhipu。
# ZHIPU_API_KEY=fill-me
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-5.1
# ZHIPU_REVIEW_MODEL=glm-5.1
# ZHIPU_REQUEST_TIMEOUT_MS=120000
# ZHIPU_AUTH_MODE=jwt
