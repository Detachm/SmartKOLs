# Frontend proxy target for local Next.js development.
SMARTKOLS_BACKEND_BASE_URL=https://vegetable-seconds-cleaning-stream.trycloudflare.com
SMARTKOLS_BACKEND_SHARED_SECRET=change-me-if-backend-proxy-auth-is-enabled
SMARTKOLS_LOCAL_AUTH_ENABLED=true

# Optional: point local UI directly at the deployed OAuth bridge instead of local /auth/x routes.
NEXT_PUBLIC_SMARTKOLS_X_AUTH_BASE_URL=https://smartkols-x-auth-20260415.vercel.app
