{
  "name": "smartkols-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "backend:dev": "tsx backend/src/app/bootstrap/start-http.ts",
    "backend:dev:local": "bash scripts/start-backend-http-local.sh",
    "backend:worker": "tsx backend/src/app/bootstrap/start-worker.ts",
    "backend:worker:local": "bash scripts/start-backend-worker-local.sh",
    "backend:typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "test:backend": "bash -lc 'tsx --test $(find backend/src -name \"*.test.ts\" -print)'",
    "build": "next build",
    "doctor": "node scripts/doctor-smartkols.mjs",
    "smoke:current": "bash scripts/smoke-current-chain.sh",
    "smoke:routes": "node scripts/smoke-route-capability.mjs",
    "smoke:e2e": "node scripts/smoke-automation-e2e.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.5.12",
    "lucide-react": "^1.8.0",
    "next": "14.2.35",
    "node-html-parser": "^7.1.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vercel": "^51.2.1"
  }
}
